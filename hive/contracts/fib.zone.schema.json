{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fib.zone.entered / fib.zone.exited / fib.structure.created — Fib Agent → Hive",
  "description": "Zone transitions on a NUK3R2 structure (100% = bottom, 0% = top). 'percent' is where price sits on that scale. in_buy_zone is evaluated under the configured anchor rule (default: price must be in the buy zone of BOTH the wick-high and body-high structures).",
  "type": "object",
  "required": ["asset_id", "chain", "contract", "symbol", "structure_id", "zone", "percent", "price", "in_buy_zone", "structure_status"],
  "properties": {
    "asset_id": {"type": "string", "pattern": "^[a-z0-9_-]+:0x[0-9a-f]{40}$"},
    "chain": {"type": "string"},
    "contract": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "symbol": {"type": "string"},
    "structure_id": {"type": "string"},
    "zone": {"enum": ["NDCAZ", "NEZ", "REDLEG", "NUK3", "NSZ", "WASTELAND", "BELOW_STRUCTURE", "ABOVE_STRUCTURE"]},
    "previous_zone": {"type": ["string", "null"]},
    "percent": {"type": "number"},
    "price": {"type": "number", "minimum": 0},
    "in_buy_zone": {"type": "boolean"},
    "structure_status": {"enum": ["ACTIVE", "WATCHING", "NEEDS_REVIEW", "DATA_ERROR", "PAUSED", "BROKEN"]},
    "study_mode": {"enum": ["mature", "young"]},
    "anchors": {"type": "object"},
    "levels": {"type": "object"},
    "observed_at": {"type": "string"}
  }
}
