{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research.verdict \u2014 Research Bee \u2192 Hive (Trader Bee, Fib Agent, Observatory)",
  "description": "One immutable research result for ONE asset at ONE timestamp. Identity is CHAIN + VERIFIED CONTRACT, never ticker. A re-run publishes a NEW verdict; consumers always use the newest verdict per asset_id. Unverifiable fields are omitted or null \u2014 never guessed.",
  "type": "object",
  "required": [
    "asset_id",
    "chain",
    "contract",
    "symbol",
    "researched_at",
    "identity",
    "gate",
    "rank"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+:(0x[0-9a-f]{40}|[1-9A-HJ-NP-Za-km-z]{32,44}|native:[a-z0-9-]+)$",
      "description": "'<chain>:<contract>' \u2014 EVM contracts lowercase; Solana base58 as-is (case-sensitive); coins without a contract use 'native:<coingecko-id>'"
    },
    "chain": {
      "type": "string",
      "description": "base | robinhood | any other chain key (only base/robinhood are tradable by the Trader Bee)"
    },
    "contract": {
      "type": "string",
      "pattern": "^(0x[0-9a-fA-F]{40}|[1-9A-HJ-NP-Za-km-z]{32,44}|native:[a-z0-9-]+)$"
    },
    "symbol": {
      "type": "string"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "researched_at": {
      "type": "string",
      "description": "ISO-8601 UTC"
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "status",
        "sources"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "UNRESOLVED",
            "HARD_STOP"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "independent sources that agree on this contract, e.g. dexscreener, basescan, geckoterminal, coingecko, project_site"
        },
        "canonical_pool": {
          "type": [
            "string",
            "null"
          ],
          "description": "pool/pair address used for price + candles"
        },
        "gt_network": {
          "type": [
            "string",
            "null"
          ]
        },
        "decoys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "same-ticker contracts seen and rejected"
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "rank": {
      "enum": [
        "BUY",
        "WATCH",
        "AVOID",
        "FAIL"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        null
      ],
      "description": "Research conviction. If absent the Trader Bee derives it from scores using config bands."
    },
    "discovery": {
      "type": "boolean",
      "description": "true = surfaced by the Base/RH discovery engine (eligible for the $10/$5/$1 tier buy)"
    },
    "scores": {
      "type": "object",
      "properties": {
        "core_quality": {
          "type": [
            "number",
            "null"
          ]
        },
        "timing": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 20
        },
        "narrative_power": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 14
        }
      }
    },
    "security": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "liquidity_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "archetype": {
      "type": [
        "string",
        "null"
      ]
    },
    "narrative_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "market_direction_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "blueprint_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}