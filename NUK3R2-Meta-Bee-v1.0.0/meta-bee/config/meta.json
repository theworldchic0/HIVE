{
  "schema_version": "1.0.0",
  "agent_id": "narrative_agent",
  "comment": "META BEE = the always-on meta hunter. Sub-agents (workers) watch one source each on their own cadence and never stop; every observation is stored; daily / weekly / monthly rollups give each meta a machine-measured curve. It is EVIDENCE for the Research Bee's narrative curve, never a score and never a trade trigger. The taxonomy below is yours to grow: the 'emerging unclassified' list shows repeated names that match no meta \u2014 that is where new metas are born.",
  "workers": {
    "cg_categories": {
      "enabled": true,
      "every_minutes": 60
    },
    "cg_trending": {
      "enabled": true,
      "every_minutes": 30
    },
    "gt_trending": {
      "enabled": true,
      "every_minutes": 30,
      "networks": [
        "base",
        "solana",
        "eth",
        "robinhood",
        "bsc"
      ]
    },
    "ds_boosts": {
      "enabled": true,
      "every_minutes": 15
    },
    "llama_categories": {
      "enabled": true,
      "every_minutes": 360
    },
    "reddit": {
      "enabled": false,
      "every_minutes": 60,
      "subs": [
        "CryptoCurrency",
        "CryptoMoonShots",
        "solana",
        "Base"
      ],
      "comment": "keyless JSON is often blocked without OAuth \u2014 off by default"
    }
  },
  "weights": {
    "cg_trending_hit": 3,
    "gt_trending_hit": 2,
    "ds_boost_hit": 0.5,
    "ds_profile_hit": 1,
    "reddit_hit": 1,
    "cg_mcap_change_24h_per_pt": 0.2,
    "cg_mcap_change_clip": 4,
    "llama_tvl_change_7d_per_pt": 0.1,
    "llama_tvl_change_clip": 3,
    "comment": "Attention = trending/boost/profile hits (paid DexScreener boosts count less: bought attention); Capital = category market-cap change + DeFi TVL change. Transparent on purpose."
  },
  "curve": {
    "min_hours_daily": 48,
    "min_days_weekly": 14,
    "min_days_monthly": 60,
    "rise_pct": 15,
    "strong_pct": 50
  },
  "retention_days": 400,
